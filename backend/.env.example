# MongoDB Connection URI (Replace with your Atlas or Local MongoDB connection string)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/shopkart?appName=ShopKart

# JWT Secret for Cookie and Authentication Token Signing
JWT_SECRET=your_jwt_secret_key_here

# Razorpay Test Mode Credentials (Get from dashboard.razorpay.com -> Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
