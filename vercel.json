{
  "version": 2,
  "buildCommand": "node build.js",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/customers/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/products/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/wishlist/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/cart/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/orders/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
